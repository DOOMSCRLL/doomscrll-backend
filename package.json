{
	"name": "doomscrll-backend",
	"private": true,
	"version": "0.1.1",
	"author": "Yakup Murat ÇAYLAK",
	"description": "Backend for the DOOMSCRLL project.",
	"main": "app.ts",
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"start": "npm run build:ts && fastify start -l info dist/app.js",
		"build": "npm run build:ts",
		"start:prod": "fastify start -l info -a 0.0.0.0 dist/app.js",
		"build:ts": "tsc && npm run type-check && npm run lint",
		"watch:ts": "tsc -w",
		"dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
		"dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint src/**/*.ts --fix",
		"type-check": "tsc --noEmit",
		"db:seed": "node --loader ts-node/esm src/scripts/seed.ts",
		"db:seed:projects": "node --loader ts-node/esm src/scripts/seed-projects.ts",
		"db:clear:projects": "node --loader ts-node/esm src/scripts/clear-projects.ts",
		"db:seed:games-tomorrow": "node --loader ts-node/esm src/scripts/seed-games-tomorrow.ts",
		"tunnel": "zrok share reserved doomscrllbackenddev --override-endpoint http://localhost:3000"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1048.0",
		"@aws-sdk/s3-request-presigner": "^3.1048.0",
		"@fastify/autoload": "^6.0.0",
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@fastify/csrf-protection": "^8.0.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/schedule": "^6.0.0",
		"@fastify/sensible": "^6.0.0",
		"@plunk/node": "^3.0.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.0.0",
		"fastify-cli": "^8.0.0",
		"fastify-plugin": "^5.0.0",
		"fastify-raw-body": "^5.0.0",
		"fastify-type-provider-zod": "^6.1.0",
		"postgres": "^3.4.9",
		"sanitize-html": "^2.17.4",
		"toad-scheduler": "^4.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.0.3",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/coverage-v8": "^4.1.9",
		"c8": "^11.0.0",
		"concurrently": "^9.0.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"fastify-tsconfig": "^3.0.0",
		"prettier": "^3.8.3",
		"ts-node": "^10.4.0",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.59.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.9"
	}
}
