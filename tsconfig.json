{
	"extends": "fastify-tsconfig",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"erasableSyntaxOnly": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
